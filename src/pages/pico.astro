<style>
	@import url("https://use.typekit.net/lbj2leo.css");

	:root {
		--silver: oklch(80.78% 0 0);
		--orange: oklch(78.97% 0.175 64.06);
	}

	.container {
		width: 90%;
		max-width: 1440px;
		margin-inline: auto;
		margin-top: 1rem;
		padding-bottom: 3rem;
	}

	html {
		box-sizing: border-box;
		font-size: 16px;
	}

	*, *:before, *:after {
		box-sizing: inherit;
	}

	p + p {
		margin-top: 1.5rem;
	}

	body, h1, h2, h3, h4, h5, h6, p, ol, ul {
		margin: 0;
		padding: 0;
		font-weight: normal;
		background: oklch(0% 0 0);
		color: var(--silver);
		font-family: loew-variable, sans-serif;
		line-height: 1.5;
	}

	img {
		max-width: 100%;
		height: auto;
		object-fit: cover;
	}

	a {
		color: var(--orange);
		font-weight: bold;
	}

	.logo {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 1.5rem;
		margin-bottom: 3rem;
	}

	.logo a {
		line-height: 0;
	}

	.picoLayout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(180px, 320px);
		gap: 2.5rem;
		align-items: start;
	}

	.invitation {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	@media (max-width: 700px) {
		.picoLayout {
			grid-template-columns: 1fr;
		}

		.invitation {
			max-width: 280px;
		}
	}
</style>
