---
import AeoArticle from '../../components/AeoArticle.astro'
import BaseLayout from '../../components/BaseLayout.astro'
import PageIntro from '../../components/PageIntro.astro'
import SanityImage from '../../components/SanityImage.astro'
import { topicArticles } from '../../lib/aeoArticles'
import { getSeoText, getSeoTexts } from '../../lib/content'
import { articleNodes, proseParagraphs, topicNodes } from '../../lib/seo'

export async function getStaticPaths() {
  const texts = await getSeoTexts()
  return texts.map((text) => ({ params: { slug: text.slug } }))
}

const slug = Astro.params.slug
if (!slug) throw new Error('SEO-tekst mangler adresse')
const text = await getSeoText(slug)
const extra = topicArticles[slug]
const [lead, ...rest] = proseParagraphs(text.intro)
const siteUrl = Astro.site?.href ?? 'https://automind.dk/'
const jsonLd = extra ? [...topicNodes(text, siteUrl), ...articleNodes(extra, siteUrl)] : topicNodes(text, siteUrl)
---

<BaseLayout
  title={extra?.title ?? text.title}
  description={extra?.description ?? lead ?? text.title}
  image={text.image}
  jsonLd={jsonLd}
>
  <PageIntro eyebrow="AutoMind Hjørring" title={extra?.title ?? text.title} description={extra?.intro ?? lead ?? ''} />
  <article class:list={['site-width', 'topic-list', !extra && 'page-bottom']}>
    {text.image?.asset && (
      <SanityImage
        image={text.image}
        class="wide-photo"
        sizes="(min-width: 1180px) 1180px, calc(100vw - 2.2rem)"
        loading="eager"
        fetchpriority="high"
      />
    )}
    {rest.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
    {text.sections.map((section) => (
      <div>
        <h2>{section.heading}</h2>
        {proseParagraphs(section.text).map((paragraph) => <p class="body-copy">{paragraph}</p>)}
      </div>
    ))}
    <p class="body-copy"><a href={text.linkHref}>{text.linkLabel}</a></p>
    <p class="body-copy"><a href="/emner/">Alle faglige emner</a></p>
  </article>
  {extra && <AeoArticle article={extra} />}
</BaseLayout>
