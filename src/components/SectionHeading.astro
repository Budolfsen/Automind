---
import TextLines from './TextLines.astro'

interface Props {
  eyebrow?: string | null
  heading: string
  href?: string | null
  linkLabel?: string | null
}

const { eyebrow, heading, href, linkLabel } = Astro.props
---

<div class="section-intro">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-heading"><TextLines text={heading} /></h2>
  </div>
  {href && linkLabel && <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>}
</div>
