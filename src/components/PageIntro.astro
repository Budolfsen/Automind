---
import TextLines from './TextLines.astro'

interface Props {
  eyebrow: string
  title: string
  description: string
}

const { eyebrow, title, description } = Astro.props
---

<section class="site-width page-top rise">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-title"><TextLines text={title} /></h1>
  <p class="body-copy">{description}</p>
</section>
