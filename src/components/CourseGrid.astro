---
import CourseCard from './CourseCard.astro'
import type { Course, PromptCard } from '../lib/types'
import Button from './Button.astro'

interface Props {
  courses: Course[]
  mode?: 'link' | 'details'
  prompt?: PromptCard | null
  level?: 2 | 3
}

const { courses, mode = 'link', prompt = null, level = 3 } = Astro.props
const PromptTitle = level === 2 ? 'h2' : 'h3'
---

<div class="course-grid">
  {courses.map((course) => (
    <CourseCard course={course} mode={mode} level={level} />
  ))}
  {prompt && (
    <article class="course-card course-card--accent">
      <p class="eyebrow">{prompt.eyebrow}</p>
      <PromptTitle>{prompt.title}</PromptTitle>
      <p>{prompt.text}</p>
      <Button href={prompt.ctaHref} variant="frost">{prompt.ctaLabel}</Button>
    </article>
  )}
</div>
